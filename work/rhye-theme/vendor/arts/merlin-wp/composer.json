{
  "name": "arts/merlin-wp",
  "description": "Better WordPress Theme Onboarding. Forked from Merlin WP by Rich Tabor.",
  "type": "library",
  "minimum-stability": "dev",
  "license": "GPL-3.0+",
  "repositories": [
    {
      "type": "path",
      "url": "/Users/art/Projects/Framework/packages/ArtsContentImporter",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "/Users/art/Projects/Framework/packages/ArtsUtilities",
      "options": {
        "symlink": true
      }
    }
  ],
  "authors": [
    {
      "name": "Artem Semkin",
      "homepage": "https://artemsemkin.com"
    },
    {
      "name": "Rich Tabor",
      "homepage": "https://richtabor.com"
    },
    {
      "name": "ProteusThemes",
      "homepage": "https://www.proteusthemes.com/"
    }
  ],
  "require": {
    "monolog/monolog": "^2.10",
    "arts/wp-content-importer-v2": "@dev",
    "arts/utilities": "@dev"
  },
  "autoload": {
    "psr-4": {
      "Arts\\Merlin\\": "src/php/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "captainhook/captainhook": "^5.27",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "ergebnis/composer-normalize": "^2.48",
    "squizlabs/php_codesniffer": "^3.13.4",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "vendor/bin/captainhook install -f -s"
    ],
    "post-update-cmd": [
      "vendor/bin/captainhook install -f -s"
    ],
    "check": [
      "@phpcs",
      "@phpstan"
    ],
    "fix": "@phpcbf",
    "normalize": "composer-normalize",
    "phpcbf": "phpcbf --standard=phpcs.xml",
    "phpcs": "phpcs --standard=phpcs.xml",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "phpstan:baseline": "phpstan analyse --memory-limit=1G --generate-baseline"
  }
}
